{
  "name": "baseball-llm-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "棒球规则知识问答系统 (RAG wiki) — 全 TypeScript + LangChain",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "index:docs": "tsx scripts/index-docs.ts",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@langchain/classic": "^1.0.0",
    "@langchain/community": "1.1.29",
    "@langchain/core": "1.2.8",
    "@langchain/ollama": "1.3.0",
    "@langchain/openai": "1.5.8",
    "@langchain/textsplitters": "1.0.1",
    "@ant-design/icons": "^6.0.0",
    "antd": "^6.6.1",
    "better-sqlite3": "12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "langchain": "1.5.9",
    "mammoth": "^1.12.1",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
